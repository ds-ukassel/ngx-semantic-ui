{
  "name": "@angular-ex/semantic-ui",
  "version": "16.1.1",
  "scripts": {
    "ng": "ng",
    "lib:lint": "ng lint lib",
    "lib:build:locales": "tsc --project projects/lib/src/lib/behaviors/localization/tsconfig.locales.json",
    "lib:build": "ng build lib && pnpm run lib:build:locales",
    "lib:build:w": "ng build lib --watch",
    "lib:build:prod": "ng build lib --configuration production && pnpm run lib:build:locales",
    "lib:test": "ng test lib --code-coverage --source-map false --progress false --watch false",
    "demo:lint": "ng lint demo",
    "demo:build": "ng build demo",
    "demo:build:prod": "ng build demo --configuration production",
    "demo:build:ghpg": "ng build demo --configuration production --base-href /ngx-semantic-ui/ --deploy-url /ngx-semantic-ui/",
    "demo:serve": "ng serve demo --host 0.0.0.0",
    "start": "pnpm run lib:build && pnpm run demo:serve",
    "start:debug": "concurrently \"pnpm:lib:build:w\" \"pnpm:lib:build:locales\" \"pnpm:demo:serve\"",
    "build": "pnpm run lib:build && pnpm run demo:build",
    "build:prod": "pnpm run lib:build:prod && pnpm run demo:build:prod",
    "build:ghpg": "pnpm run lib:build:prod && pnpm run demo:build:ghpg",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm run lib:test",
    "lint": "pnpm run lib:lint && pnpm run demo:lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "bowser": "^2.14.1",
    "date-fns": "^4.4.0",
    "element-closest": "^3.0.2",
    "extend": "^3.0.2",
    "is-ua-webview": "^1.1.2",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular/build": "^22.0.5",
    "@angular/cli": "~22.0.5",
    "@angular/compiler-cli": "^22.0.4",
    "@eslint/js": "^9.39.4",
    "@types/element-closest": "^3.0.2",
    "@types/extend": "^3.0.4",
    "@types/jasmine": "~4.3.6",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "angular-eslint": "^22.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "fs-extra": "^11.3.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^22.0.1",
    "prismjs": "^1.30.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
