{
  "name": "@angular-ex/semantic-ui",
  "version": "16.1.1",
  "scripts": {
    "ng": "ng",
    "lib:lint": "ng lint lib",
    "lib:build:locales": "tsc --project projects/lib/src/lib/behaviors/localization/tsconfig.locales.json && node ./scripts/locales",
    "lib:build": "ng build lib && pnpm run lib:build:locales",
    "lib:build:w": "ng build lib --watch",
    "lib:build:prod": "ng build lib --configuration production && pnpm run lib:build:locales",
    "lib:test": "ng test lib --code-coverage --source-map false --progress false --watch false",
    "demo:lint": "ng lint demo",
    "demo:build": "ng build demo",
    "demo:build:prod": "ng build demo --configuration production",
    "demo:build:ghpg": "ng build demo --configuration production --base-href /ngx-semantic-ui/ --deploy-url /ngx-semantic-ui/",
    "demo:serve": "ng serve demo --host 0.0.0.0",
    "start": "pnpm run lib:build && pnpm run demo:serve",
    "start:debug": "concurrently \"pnpm:lib:build:w\" \"pnpm:lib:build:locales\" \"pnpm:demo:serve\"",
    "build": "pnpm run lib:build && pnpm run demo:build",
    "build:prod": "pnpm run lib:build:prod && pnpm run demo:build:prod",
    "build:ghpg": "pnpm run lib:build:prod && pnpm run demo:build:ghpg",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm run lib:test",
    "lint": "pnpm run lib:lint && pnpm run demo:lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "bowser": "^2.11.0",
    "date-fns": "^2.30.0",
    "element-closest": "^3.0.2",
    "extend": "^3.0.2",
    "is-ua-webview": "^1.1.2",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "16.1.2",
    "@angular-eslint/eslint-plugin": "16.1.2",
    "@angular-eslint/eslint-plugin-template": "16.1.2",
    "@angular-eslint/schematics": "16.1.2",
    "@angular-eslint/template-parser": "16.1.2",
    "@angular/build": "^20.3.30",
    "@angular/cli": "~20.3.30",
    "@angular/compiler-cli": "^20.3.25",
    "@types/element-closest": "^3.0.0",
    "@types/extend": "^3.0.1",
    "@types/jasmine": "~4.3.0",
    "@types/prismjs": "^1.26.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "concurrently": "^8.2.1",
    "eslint": "^8.47.0",
    "fs-extra": "^11.1.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "prismjs": "^1.29.0",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}